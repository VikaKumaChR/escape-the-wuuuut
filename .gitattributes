# Normalize text files in the repository
* text=auto

# Unity YAML assets: always LF so Windows and macOS produce identical diffs
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.meta      text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf
*.asmdef    text eol=lf
*.cs        text diff=csharp
*.csv       text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.webp binary
*.psd  binary
*.otf  binary
*.ttf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.exr  binary
